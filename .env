# ============================================
# PRODUCTION ENVIRONMENT - Vercel + Neon
# ============================================

# Node Environment
NODE_ENV=production

# App URL - Your Vercel production URL
APP_URL=https://spihead.vercel.app

# Session Secrets - Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_32_chars_minimum_here
REFRESH_SECRET=your_refresh_secret_32_chars_minimum_here
RESET_SECRET=your_reset_secret_32_chars_minimum_here

# ============================================
# DATABASE - Neon PostgreSQL
# ============================================

# Your Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@ep-cool-forest-123456.us-east-2.aws.neon.tech/your_database?sslmode=require

# Neon Pooled Connection (Optional - for serverless)
DATABASE_POOL_URL=postgresql://username:password@ep-cool-forest-123456-pooler.us-east-2.aws.neon.tech/your_database?sslmode=require

# ============================================
# GEMINI AI - Required for AI features
# ============================================

GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# EMAIL - For sending verification emails
# ============================================

# Option A: SendGrid (Recommended for production)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=your_sendgrid_api_key
EMAIL_FROM=SPIHEAD <noreply@spihead.vercel.app>

# Option B: Gmail (if you prefer)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password
# EMAIL_FROM=SPIHEAD <your-email@gmail.com>

# Option C: AWS SES
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-ses-username
# EMAIL_PASS=your-ses-password
# EMAIL_FROM=SPIHEAD <noreply@spihead.vercel.app>

# ============================================
# OAuth - Google (Optional)
# ============================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# OAuth - Microsoft 365 (Optional)
# ============================================

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ============================================
# Security & CORS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGIN=https://spihead.vercel.app,https://spihead.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Expiry (in hours)
SESSION_EXPIRY_HOURS=24
REFRESH_EXPIRY_DAYS=7

# ============================================
# Logging & Debugging
# ============================================

# Set to 'true' for detailed logs, 'false' for production
DEBUG=false
LOG_LEVEL=error
