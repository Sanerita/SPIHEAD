# Neon PostgreSQL Database
DATABASE_URL="postgresql://user:password@ep-...aws.neon.tech/dbname"

# Google Gemini AI
GEMINI_API_KEY="your-google-ai-studio-api-key"

# Microsoft 365 OAuth (for production)
MICROSOFT_CLIENT_ID="your-azure-app-client-id"
MICROSOFT_TENANT_ID="your-tenant-id"
MICROSOFT_CLIENT_SECRET="your-client-secret"

# App URL
APP_URL="https://spihead.vercel.app"
NEXTAUTH_URL="https://spihead.vercel.app"
NEXTAUTH_SECRET="your-secret-key"

# Email (for notifications)
EMAIL_HOST="smtp.sendgrid.net"
EMAIL_PORT=587
EMAIL_USER="apikey"
EMAIL_PASS="your-sendgrid-api-key"
EMAIL_FROM="noreply@spihead.com"

# Allowed Origins for CORS
ALLOWED_ORIGINS="https://spihead.vercel.app,http://localhost:3000,http://localhost:5173"

# Node Environment
NODE_ENV="production"
